{
  "name": "@paideia/sutd-shell",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b && vite build",
    "dev": "vite --host 127.0.0.1",
    "lint": "tsc -b --pretty false",
    "test": "playwright test --config playwright.config.ts",
    "test:a11y": "playwright test --config playwright.config.ts tests/a11y.spec.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@paideia/prediction-gate": "workspace:*",
    "@paideia/sutd-sims": "workspace:*",
    "react": "^18.3.0",
    "react-dom": "^18.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@playwright/test": "^1.49.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "typescript": "^5.6.0",
    "vite": "^6.4.2"
  }
}
